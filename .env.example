# Postgres connection string. Locally: docker compose up -d db
DATABASE_URL=postgres://nuraya:nuraya@127.0.0.1:5432/nuraya

# Long random string, e.g. `openssl rand -hex 32`. Signs admin sessions.
PAYLOAD_SECRET=change-me

# Public origin of the site, no trailing slash. Used for canonical URLs,
# the sitemap and admin preview links.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Production only (docker compose): password for the bundled Postgres.
# POSTGRES_PASSWORD=change-me
